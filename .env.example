# Optional environment variables. The CLI and server read these directly; they
# are not loaded from a .env file automatically.

# Index file used by the server and CLI.
# Default: ./data/pages.json
ARCGIS_DOCS_DATA=./data/pages.json

# Override the HTTP User-Agent used by the indexer.
# ARCGIS_DOCS_USER_AGENT=arcgis-docs-mcp/0.1 (local index)
