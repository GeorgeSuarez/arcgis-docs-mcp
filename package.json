{
  "name": "arcgis-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server for searching ArcGIS Maps SDK for JavaScript documentation.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "index": "tsx src/indexer/cli.ts index",
    "index:refresh": "tsx src/indexer/cli.ts index --force",
    "index:status": "tsx src/indexer/cli.ts status",
    "index:search": "tsx src/indexer/cli.ts search",
    "llms": "tsx src/indexer/cli.ts llms",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "arcgis",
    "esri",
    "mcp",
    "model-context-protocol",
    "docs",
    "search",
    "javascript",
    "maps",
    "gis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "minisearch": "^7.2.0",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
